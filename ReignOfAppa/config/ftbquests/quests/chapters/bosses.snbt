	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: ["All bosses have their own description, consisting of &blore,&r &esummoning information&r and &cthreat level.&r The threat level is rated on how difficult the boss is in &bthat stage of progression&r, not in the entire modpack. To the left of the boss quests, there are specific chestplates. Those are the recommended armors for that boss. Also when you beat a boss, an &eimage next to/near the quest&r will appear, clicking it will make an aftermath message pop up in &cchat.&r"]
			hide_dependency_lines: true
			hide_dependent_lines: true
			id: "0233019D8E5264D9"
			rewards: [{
				id: "594765F23DBBF2A7"
				type: "xp"
				xp: 2
			}]
			shape: "gear"
			size: 1.5d
			tasks: [{
				id: "506D57DAD9807FA2"
				title: "Bosses and their descriptions"
				type: "checkmark"
			}]
			x: -0.5d
			y: 4.0d
		}
		{
			dependencies: ["0233019D8E5264D9"]
			description: [
				"In ages past, the first guardians were forged to protect treasures long forgotten. Or so the scrolls claim. I suspect their true purpose was darker."
				"The Ferrous Wroughtnaut stands motionless in a hidden underground chamber, a metal colossus awaiting no master, only victims. Its Axe bears the scars of wars no living soul remembers. The ancients built its armor to reject every blade. But nothing is perfect. A wound from a forgotten battle still gapes in its chest, a blade still lodged beneath the metal. The guardians left it open as a mere lesson. When the Wroughtnaut falls, it kneels for the first time in a thousand years and yields its axe and a shard of its own armory to the one who understood. To the one, who aimed for the wound."
				""
				""
				""
				"Threat Level: ☠"
				"Summon: Find a Wrought Chamber underground."
				"Recommended Armor: Iron"
			]
			id: "206E6EE1994EA27F"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "5ADA62F093B56B7C"
