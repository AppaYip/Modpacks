				type: "checkmark"
			}]
			title: "&#5600FF&lE&#5400F7&lv&#5100EF&le&#4F00E7&ln&#4C00DF&lt &#4800CF&lH&#4500C7&lo&#4300BF&lr&#4000B7&li&#3E00AF&lz&#3B00A7&lo&#39009F&ln&#370097&l, &#320088&lt&#2F0080&lh&#2D0078&le &#280068&lN&#260060&li&#230058&lg&#210050&lh&#1E0048&lt&#1C0040&lw&#1A0038&la&#170030&lr&#150028&ld&#120020&le&#100018&ln"
			x: 0.0d
